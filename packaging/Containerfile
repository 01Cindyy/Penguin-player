# The environment the release packages are built in (see build.sh): Debian 13, the
# oldest distribution with the GTK 4.18 and libadwaita 1.7 the app needs. A program
# built against its glibc runs on Debian 13, Ubuntu 25.04, Fedora 42 and anything
# newer. Everything is pinned, so the packages don't change with the day they're built.

# The official Rust image on Debian 13, by its checksum.
FROM docker.io/library/rust:1.99.0-slim-trixie@sha256:2752b332db73fdbb7dc576f06c82ed1f312005784ef913d7e04a28f5f55dc581

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libgtk-4-dev libadwaita-1-dev libasound2-dev libdbus-1-dev \
        cmake make pkgconf \
        dpkg-dev rpm squashfs-tools desktop-file-utils appstream \
        binutils ca-certificates curl file \
    && rm -rf /var/lib/apt/lists/*

# Writes THIRD-PARTY-LICENSES.txt.
RUN cargo install --locked cargo-about --version 0.9.2 --features cli \
    && cargo about --version \
    && rm -rf /usr/local/cargo/registry

# The AppImage runtime: the small program at the start of an AppImage that opens the
# rest of it. A tagged release, checked against the checksum GitHub publishes for it.
ARG APPIMAGE_RUNTIME=20251108
ARG APPIMAGE_RUNTIME_SHA256=2fca8b443c92510f1483a883f60061ad09b46b978b2631c807cd873a47ec260d
RUN curl -fsSL -o /usr/local/share/appimage-runtime-x86_64 \
        "https://github.com/AppImage/type2-runtime/releases/download/$APPIMAGE_RUNTIME/runtime-x86_64" \
    && echo "$APPIMAGE_RUNTIME_SHA256  /usr/local/share/appimage-runtime-x86_64" | sha256sum -c -
